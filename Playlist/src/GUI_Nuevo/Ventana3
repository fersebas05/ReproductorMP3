    private void activarAleatorio() {
        this.playlistAleatoria.limpiar();
        Random random = new Random();

        while(this.playlistAleatoria.tamanio() < this.listaPrincipal.tamanio()) {
            int indice = random.nextInt(this.listaPrincipal.tamanio());
            Cancion cancion = (Cancion) this.listaPrincipal.devolver(indice);

            if(this.playlistAleatoria.buscar(cancion) == -1) {
                this.playlistAleatoria.insertar(cancion, this.playlistAleatoria.tamanio());
            }
        }

        NodoDoble aux = this.playlistAleatoria.getFrenteL();
        this.listaPrincipal.limpiar();
        while(aux != null) {
            this.listaPrincipal.insertar(aux.getNodoInfo(), this.listaPrincipal.tamanio());
            aux = aux.getNextNodo();
        }

        this.modoAleatorio = true;
        reproducirNodoActual();

        this.nodoActual = this.listaPrincipal.getFrenteL();

        System.out.println("\nLista Aleatoria: ");
        for(int i = 0; i < this.listaPrincipal.tamanio(); i++) {
            Cancion c = (Cancion)this.listaPrincipal.devolver(i);
            System.out.println("Cancion agregada: " + c.toString());
        }
    }

    private void desactivarAleatorio() {
        this.modoAleatorio = false;
        if(this.criterioActual != null) {
            activarOrden(this.criterioActual);
        }
        else{
            this.nodoActual = this.listaPrincipal.getFrenteL();
        }

        System.out.println("\nLista no Aleatoria: ");
        for(int i = 0; i < this.listaPrincipal.tamanio(); i++) {
            Cancion c = (Cancion)this.listaPrincipal.devolver(i);
            System.out.println("Cancion agregada: " + c.toString());
        }
    }

}
